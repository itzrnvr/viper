# viper .gitignore
#
# Build artifacts
build/
out/
*.o
*.obj
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp

# Visual Studio / MSVC
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.ncb
*.cache
ipch/
*.aps
*.pch

# CUDA
*.cu.cubin
*.cubin
*.fatbin
*.ptx
*.gpubin

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/

# Python (FP64 oracle, convert tools)
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Debug / test markers
test_marker.txt
*_test_marker.txt

# Model artifacts (large, never committed)
/models/
/hf-cache/
*.viper
*.safetensors
*.bin
*.gguf
*.pt
*.pth

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Build outputs that may get generated at runtime
results/
